<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/glassPillRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/bg_liquid_glass"
    android:elevation="14dp"
    android:gravity="center_vertical"
    android:maxWidth="360dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <!-- Mini Glass Translate Icon -->
    <ImageView
        android:id="@+id/ivPillIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_translate"
        app:tint="#00E5FF" />

    <!-- Mini Loading Indicator (when fetching translation) -->
    <ProgressBar
        android:id="@+id/pillProgressBar"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:indeterminate="true"
        android:indeterminateTint="#00E5FF"
        android:visibility="gone" />

    <!-- Translated Text Block with Full Text Scrolling -->
    <ScrollView
        android:id="@+id/pillScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="8dp">

        <TextView
            android:id="@+id/tvPillText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="Перевод..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="normal" />
    </ScrollView>

    <!-- Action: Copy to clipboard -->
    <ImageView
        android:id="@+id/btnPillCopy"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Copy"
        android:padding="2dp"
        android:src="@drawable/ic_copy"
        app:tint="#B0BEC5" />

    <!-- Action: Close / Dismiss -->
    <ImageView
        android:id="@+id/btnPillClose"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:contentDescription="Dismiss"
        android:padding="3dp"
        android:src="@drawable/ic_close"
        app:tint="#90A4AE" />

</LinearLayout>
