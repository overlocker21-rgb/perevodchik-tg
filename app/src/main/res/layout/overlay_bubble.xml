<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <!-- Frosted Liquid Glass Floating Button (iOS 26 Style) -->
    <ImageView
        android:id="@+id/btnBubble"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_liquid_bubble"
        android:contentDescription="Translate"
        android:elevation="12dp"
        android:padding="13dp"
        android:src="@drawable/ic_translate"
        app:tint="#F0F8FF" />

    <!-- Active Indicator Dot (Neon Cyan glow when auto-translate is ON) -->
    <View
        android:id="@+id/bubbleActiveIndicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bg_active_dot"
        android:elevation="14dp"
        android:visibility="gone" />

</FrameLayout>
